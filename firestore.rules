rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function getUserAgencyId() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.agencyId
        : null;
    }

    function belongsToMyAgency(data) {
      return isMaster() || (data.agencyId != null && data.agencyId == getUserAgencyId());
    }

    match /clients/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /vehicles/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /deals/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /tasks/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /notes/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /files/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /vehicleExpenses/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /agency_tags/{id} {
      allow read: if isAuthenticated() && belongsToMyAgency(resource.data);
      allow create: if isAuthenticated() && belongsToMyAgency(request.resource.data);
      allow update, delete: if isAuthenticated() && belongsToMyAgency(resource.data);
    }

    match /agencies/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isMaster() || (isAuthenticated() && getUserAgencyId() == id);
      allow delete: if isMaster();
    }

    match /users/{id} {
      allow read, write: if isAuthenticated();
    }

    match /agencyChats/{id} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
