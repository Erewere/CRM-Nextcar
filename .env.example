# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending automated emails.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Stripe config
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLIC_KEY="pk_test_..."
VITE_STRIPE_PRICE_ID="price_..."
# Lo que se muestra al mes por usuario. Debe coincidir con lo que cobra el
# precio de Stripe de arriba; esta solo se muestra, no cobra.
VITE_STRIPE_PRICE_AMOUNT="199"
# Optional: URL base for API calls when hosted on external custom domain
VITE_API_URL=""
GEMINI_API_KEY=

# Credenciales de la cuenta de servicio de Firebase (JSON en base64)
FIREBASE_SERVICE_ACCOUNT_B64=""

# Base de datos de Firestore. Dejarlas vacias usa la de produccion.
# Para correr en local contra datos de prueba, poner aqui el id de otra base
# (el proyecto de Firebase tiene varias sin usar). Las dos deben coincidir:
# la primera la usa el servidor y la segunda el navegador.
FIRESTORE_DATABASE_ID=""
VITE_FIRESTORE_DATABASE_ID=""
